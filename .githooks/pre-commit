#!/bin/sh
# Same checks as `yarn build`: tsc, and the ESLint run Vite does over src.
# Skip once with `git commit --no-verify`.
cd "$(git rev-parse --show-toplevel)" || exit 1

staged=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx)$')
[ -z "$staged" ] && exit 0

echo "pre-commit: eslint (whole project, max-warnings 0)"
npx eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 || {
  echo "pre-commit: ESLint failed. Fix it or commit with --no-verify."
  exit 1
}

echo "pre-commit: tsc --noEmit"
npx tsc --noEmit || {
  echo "pre-commit: TypeScript failed. Fix it or commit with --no-verify."
  exit 1
}
